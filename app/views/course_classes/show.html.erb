<div class="w-full grid grid-cols-1 px-4 pt-6 xl:grid-cols-3 xl:gap-4 dark:bg-gray-900">
  <div class="mb-4 col-span-full xl:mb-2">
    <div class="flex items-center justify-between gap-4">
    <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
      <%= link_to "Voltar para o curso",
                    course_path(@course),
                    class: 'text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800' %>
      <%= [Course.model_name.human.singularize, @course.name].join(' - ') %>
    </h1>
    <% if @course_completed && @certificate.present? %>
      <%= link_to "Baixar certificado", download_course_certificate_path(@course),
                  data: { certificate_download: true },
                  class: "inline-flex shrink-0 items-center rounded-lg bg-green-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-green-800" %>
    <% end %>
    </div>
  </div>
  <div class="col-span-full min-w-0 xl:col-span-2">
    <div class="w-full h-[calc(100vh-8rem)] min-h-[24rem] overflow-hidden bg-black border border-gray-200 rounded-lg shadow-sm dark:border-gray-700 dark:bg-gray-800">
      <video id="my-player"
             data-controller="ui-video"
             data-complete-url="<%= course_complete_course_class_path(@course, @course_class) %>"
             class="video-js w-full h-full object-contain"
             controls
             preload="auto"
             data-setup='{"fill": true}'>
        <source src="<%= rails_blob_path @course_class.video if @course_class&.video&.present? %>"  />
        <p class="vjs-no-js">
          To view this video please enable JavaScript, and consider upgrading to a
          web browser that
          <a href="https://videojs.com/html5-video-support/" target="_blank">
            supports HTML5 video
          </a>
        </p>
      </video>
    </div>
  </div>
  <!-- Right Content -->
  <div class="col-span-full xl:col-auto">
    <div class=" mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 dark:bg-gray-800">
      <div class="p-4 sm:p-6 items-center sm:flex xl:block 2xl:flex sm:space-x-4 xl:space-x-0 2xl:space-x-4">
        <img class="mb-4 rounded-lg w-28 h-28 sm:mb-0 xl:mb-4 2xl:mb-0" src="https://flowbite-admin-dashboard.vercel.app/images/users/bonnie-green-2x.png" alt="Jese picture">
        <div>
          <h3 class="mb-1 text-xl font-bold text-gray-900 dark:text-white">
            <%= @course_class.name %>
          </h3>
          <div class="mb-4 text-sm text-gray-500 dark:text-gray-400">
            <%= @course_class.description %>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <%# Ação principal %>
          <% if @can_manage_course_classes %>
            <div class="flex gap-2">
              <%= link_to "Editar aula",
                          edit_course_course_class_path([@course, @course_class]),
                          class: 'inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800' %>
              <%= button_to "Remover aula",
                            course_course_class_path([@course, @course_class]),
                            method: :delete,
                            class: 'py-2 px-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700' %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
    <div class="w-full p-4 bg-white border border-gray-200 rounded-lg shadow sm:p-6 dark:bg-gray-800 dark:border-gray-700">
      <div class="flex items-center justify-between mb-4">
        <h5 class="text-xl font-bold leading-none text-gray-900 dark:text-white">Todas as aulas</h5>
      </div>
      <div class="flow-root">
        <ul role="list" class="divide-y divide-gray-200 dark:divide-gray-700">
          <% @course_classes.each do |cc| %>
            <li id="<%= dom_id(cc) %>" class="course-class<%= " course-class-active" if cc == @course_class %> py-3 sm:py-4">
              <%= link_to course_course_class_path(@course, cc), data: { turbo: false } do %>
                <div class="flex items-center">
                  <div class="flex-shrink-0">
                    <%= image_tag cc.thumbnail,
                                class: 'w-8 h-8 rounded-full' if cc&.thumbnail&.present? %>
                  </div>
                  <div class="flex-1 min-w-0 ms-4">
                    <p class="text-sm font-medium text-gray-900 truncate dark:text-white">
                      <%= cc.name %>
                    </p>
                    <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                      <%= cc.description %>
                    </p>
                  </div>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</div>
