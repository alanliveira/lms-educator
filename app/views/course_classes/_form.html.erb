<%= form_with(model: course_class) do |form| %>
  <% if course_class.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(course_class.errors.count, "error") %> prohibited this course_class from being saved:</h2>
      <ul>
        <% course_class.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>
  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.rich_text_area :description %>
  </div>
  <div>
    <%= form.label :thumbnail, style: "display: block" %>
    <%= form.file_field :thumbnail %>
  </div>
  <div>
    <%= form.submit %>
  </div>
<% end %>
