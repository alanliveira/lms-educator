<%# Errors %>
<% if company.errors.any? %>
  <div id="toast-notification" class="fixed flex flex-col items-center w-full max-w-xs p-4 space-x-4 text-gray-500 bg-white divide-x rtl:divide-x-reverse divide-gray-200 rounded-lg shadow right-5 bottom-5 dark:text-gray-400 dark:divide-gray-700 dark:bg-red-800" role="alert">
    <div class="flex items-center item mb-3 w-full">
      <span class="mb-1 text-sm font-semibold text-gray-900 dark:text-white">
        <%= pluralize(company.errors.count, "error") %> foram encontrados ao <%= company.new_record? ? 'criar' : 'atualizar' %> a <%= Company.model_name.human.singularize %>
      </span>
      <button type="button" id="trigger-notification" data-controller="ui-toast-notification" data-action="click->ui-toast-notification#close" class="ms-auto -mx-1.5 -my-1.5 bg-white justify-center items-center flex-shrink-0 text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex h-8 w-8 dark:text-white dark:hover:text-white dark:bg-red-800 dark:hover:bg-gray-700" data-dismiss-target="#toast-notification" aria-label="Close">
        <span class="sr-only">Fechar</span>
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
      </button>
    </div>
    <div class="flex items-center w-full">
      <div class="ms-3 text-sm font-normal">
        <ul class="list-disc">
          <% company.errors.each do |error| %>
            <li class="text-gray-900 dark:text-white"><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
<% end %>
<div class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
  <%= form_with(model: company, class: 'grid gap-4 mb-4') do |form| %>
    <%# Dados da empresa %>
    <div class="flex flex-col gap-4 mb-4 content-start col-span-2 md:col-span-1">
      <div class="col-span-1">
        <h4 class="text-2xl font-bold dark:text-white">Gerais</h4>
      </div>
      <div class="col-span-1">
        <%= form.label :name, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
        <%= form.text_field :name, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
      </div>
      <div class="col-span-1">
        <%= form.label :fantasy_name, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
        <%= form.text_field :fantasy_name, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
      </div>
      <div class="col-span-1">
        <%= form.label :cnpj, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
        <%= form.text_field :cnpj, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
      </div>
      <div class="col-span-1">
        <%= form.label :address, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
        <%= form.text_field :address, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
      </div>
      <div class="col-span-1">
        <%= form.label :logo,
                       class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
        <%= form.file_field :logo,
                            accept: "image/png,image/jpeg,image/webp",
                            class: 'w-full block text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 focus:outline-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400' %>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">PNG, JPEG ou WebP; máximo de 2 MB.</p>
      </div>
      <div class="col-span-1">
        <%= form.label :subdomain, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
        <%= form.text_field :subdomain, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
      </div>
    </div>
    <div class="flex flex-col gap-4 mb-4 content-start col-span-2 md:col-span-1">
      <div class="col-span-1">
        <h4 class="text-2xl font-bold dark:text-white">Proprietário</h4>
      </div>
      <%= form.fields_for :users do |user_form| %>
        <% if form.object.new_record? || owner_user_ids.include?(user_form.object.id) %>
          <div class="col-span-1">
            <%= user_form.label :full_name, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
            <%= user_form.text_field :full_name, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
          </div>
          <div class="col-span-1">
            <%= user_form.label :department, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
            <%= user_form.text_field :department, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
          </div>
          <div class="col-span-1">
            <%= user_form.label :email, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
            <%= user_form.text_field :email, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
          </div>
          <div class="col-span-1">
            <%= user_form.label :password, class: 'block mb-2 text-sm font-medium text-gray-900 dark:text-white' %>
            <%= user_form.password_field :password, class: 'bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-600 dark:border-gray-500 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500' %>
          </div>
          <div class="col-span-1 flex items-center ps-4 border border-gray-200 rounded dark:border-gray-700">
            <%= user_form.check_box :active, disabled: user_form.object.new_record?, class: 'w-4 h-4 text-green-600 bg-gray-100 border-gray-300 rounded focus:ring-green-500 dark:focus:ring-green-600 dark:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600' %>
            <%= user_form.label :active, class: 'w-full py-4 ms-2 text-sm font-medium text-gray-900 dark:text-gray-300' %>
          </div>
        <% end %>
      <% end %>
    </div>
    <%= form.submit class: 'col-span-2 text-white inline-flex items-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800' do %>
      <svg class="me-1 -ms-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd"></path></svg>
      Add new product
    <% end %>
  <% end %>
</div>
