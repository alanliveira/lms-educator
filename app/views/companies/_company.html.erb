<tr id="<%= dom_id company %>" class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
  <td class="w-4 p-4">
    <div class="flex items-center">
      <input id="checkbox-table-search-1" type="checkbox" class="w-4 h-4 text-blue-600 bg-gray-100 border-gray-300 rounded focus:ring-blue-500 dark:focus:ring-blue-600 dark:ring-offset-gray-800 dark:focus:ring-offset-gray-800 focus:ring-2 dark:bg-gray-700 dark:border-gray-600">
      <label for="checkbox-table-search-1" class="sr-only">checkbox</label>
    </div>
  </td>
  <td class="px-6 py-4">
    <%= company.id %>
  </td>
  <td class="px-6 py-4">
    <%= company.fantasy_name %>
  </td>
  <td class="px-6 py-4">
    <%= company.address %>
  </td>
  <td class="px-6 py-4">
    <%= company.owner&.full_name if company.respond_to?(:owner) %>
  </td>
  <td class="px-6 py-4">
    <%= link_to 'Visualizar',
                company_path(company),
                data: { modal_target: "crud-modal",
                        modal_toggle: "crud-modal",
                        turbo_frame: "modal-company",
                        controller: 'ui-modal',
                        action: 'turbo:frame-load->ui-modal#open turbo:submit-end->ui-modal#submit' },
                class: 'font-medium text-blue-600 dark:text-blue-500 hover:underline' %>
    <%#= company.owner_id %>
  </td>
</tr>
