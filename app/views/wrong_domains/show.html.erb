<div class="flex flex-col items-center justify-center px-6 pt-8 mx-auto md:min-h-screen dark:bg-gray-900">
  <div class="w-full max-w-2xl p-6 space-y-8 sm:p-8 bg-white rounded-lg shadow dark:bg-gray-800">
    <%= render "shared/notification" %>

    <div class="space-y-2">
      <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Página errada</h1>
      <p class="text-sm text-gray-600 dark:text-gray-300">
        Acesse a plataforma pelo endereço informado pela sua empresa. Deixe seus dados para que nossa equipe confirme o acesso correto.
      </p>
    </div>

    <%= form_with url: wrong_domain_contact_path, scope: :contact, class: "space-y-5" do |form| %>
      <div>
        <%= form.label :name, "Nome", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
        <%= form.text_field :name, value: @contact[:name], required: true, autocomplete: "name", class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <div>
        <%= form.label :phone, "Telefone", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
        <%= form.telephone_field :phone, value: @contact[:phone], required: true, autocomplete: "tel", class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <div>
        <%= form.label :email, "Email", class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
        <%= form.email_field :email, value: @contact[:email], required: true, autocomplete: "email", class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>

      <div class="flex items-center gap-3">
        <%= form.check_box :whatsapp, { checked: ActiveModel::Type::Boolean.new.cast(@contact[:whatsapp]), class: "w-4 h-4 text-primary-600 bg-gray-100 border-gray-300 rounded focus:ring-primary-500 dark:bg-gray-700 dark:border-gray-600" }, "1", "0" %>
        <%= form.label :whatsapp, "Pode contactar pelo WhatsApp", class: "text-sm font-medium text-gray-900 dark:text-gray-300" %>
      </div>

      <%= form.submit "Solicitar contato", class: "w-full px-5 py-3 text-base font-medium text-center text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800" %>
    <% end %>
  </div>
</div>
