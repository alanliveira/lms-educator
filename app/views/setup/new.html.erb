<div class="flex flex-col items-center justify-center px-6 pt-8 mx-auto md:min-h-screen dark:bg-gray-900">
  <div class="w-full max-w-3xl p-6 space-y-8 sm:p-8 bg-white rounded-lg shadow dark:bg-gray-800">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Configuração inicial</h1>

    <% if @company.errors.any? || @owner.errors.any? %>
      <div class="rounded-lg bg-red-50 p-4 text-sm text-red-800 dark:bg-red-900 dark:text-red-100">
        <ul class="list-disc pl-5">
          <% @company.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
          <% @owner.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with url: setup_path, multipart: true, class: "grid gap-6 md:grid-cols-2" do |form| %>
      <div class="space-y-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Empresa</h2>

        <%= fields_for :company, @company do |company_form| %>
          <div>
            <%= company_form.label :name, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= company_form.text_field :name, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= company_form.label :fantasy_name, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= company_form.text_field :fantasy_name, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= company_form.label :cnpj, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= company_form.text_field :cnpj, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= company_form.label :address, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= company_form.text_field :address, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= company_form.label :logo, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= company_form.file_field :logo, required: true, class: "w-full block text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 dark:text-gray-400 dark:bg-gray-700 dark:border-gray-600" %>
          </div>
        <% end %>
      </div>

      <div class="space-y-4">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Usuário administrador</h2>

        <%= fields_for :user, @owner do |user_form| %>
          <div>
            <%= user_form.label :full_name, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= user_form.text_field :full_name, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= user_form.label :department, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= user_form.text_field :department, required: true, class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= user_form.label :email, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= user_form.email_field :email, required: true, autocomplete: "email", class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= user_form.label :password, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= user_form.password_field :password, required: true, autocomplete: "new-password", class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
          <div>
            <%= user_form.label :password_confirmation, class: "block mb-2 text-sm font-medium text-gray-900 dark:text-white" %>
            <%= user_form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
          </div>
        <% end %>
      </div>

      <%= form.submit "Criar ambiente", class: "md:col-span-2 w-full px-5 py-3 text-base font-medium text-center text-white bg-primary-700 rounded-lg hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800" %>
    <% end %>
  </div>
</div>
