<div class="pt-6 2xl:px-4">
  <div class="grid gap-4 grid-cols-1">
    <%= render "shared/notification", alert_message: flash[:alert], notice_message: flash[:notice] %>
    <div class="col-span-1 flex items-center justify-between md:divide-x md:divide-gray-100 dark:divide-gray-700">
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">Sessões</h1>
    </div>

    <div class="col-span-1 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      <% @sessions.each do |session| %>
        <div id="<%= dom_id session %>" class="p-6 bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700">
          <h2 class="mb-3 text-lg font-semibold text-gray-900 dark:text-white">Dispositivo</h2>
          <dl class="space-y-2 text-sm text-gray-500 dark:text-gray-400">
            <div><dt class="font-semibold inline">Navegador: </dt><dd class="inline"><%= session.user_agent %></dd></div>
            <div><dt class="font-semibold inline">IP: </dt><dd class="inline"><%= session.ip_address %></dd></div>
            <div><dt class="font-semibold inline">Início: </dt><dd class="inline"><%= l(session.created_at) %></dd></div>
          </dl>
          <%= button_to "Encerrar sessão", session, method: :delete, class: "mt-5 text-white bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 font-medium rounded-lg text-sm px-5 py-2.5" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
