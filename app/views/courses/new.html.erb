<div class="grid w-full grid-cols-1 px-4 pt-6 xl:grid-cols-3 xl:gap-4 dark:bg-gray-900">
  <div class="mb-4 col-span-full xl:mb-2">
    <%= render 'shared/notification' %>
    <div class="flex items-center mb-4 sm:mb-0">
      <%# cabelaçho %>
      <h1 class="text-xl w-full flex justify-between font-semibold text-gray-900 sm:text-2xl dark:text-white">
        <%= Course.model_name.human.pluralize %>
        <%# Ação principal %>
        <% if Current.user.has_role?(:admin) %>
          <%= link_to "Cancelar",
                        courses_path,
                        class: 'text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800' %>
        <% end %>
      </h1>
    </div>
  </div>
  <%# Corpo %>
  <div class="col-span-full">
    <div class="grid grid-cols-1 md:p-4 sm:p-6 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-1 dark:border-gray-700 dark:bg-gray-800">
      <%= render "form", course: @course %>
    </div>
  </div>
</div>
