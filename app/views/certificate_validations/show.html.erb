<main class="mx-auto max-w-5xl px-4 py-10">
  <div class="mb-6 rounded-lg border border-green-200 bg-green-50 p-6 text-green-900">
    <h1 class="text-2xl font-semibold">Certificado válido</h1>
    <p class="mt-2 text-sm">Código de verificação: <strong><%= @issuance.verification_code %></strong></p>
  </div>

  <div class="grid gap-6 lg:grid-cols-[20rem_minmax(0,1fr)]">
    <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <dl class="space-y-4 text-sm">
        <div>
          <dt class="font-medium text-gray-500">Aluno</dt>
          <dd class="text-gray-900"><%= @issuance.user.full_name.presence || @issuance.user.email_address %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-500">Curso</dt>
          <dd class="text-gray-900"><%= @issuance.course.name %></dd>
        </div>
        <div>
          <dt class="font-medium text-gray-500">Carga horária</dt>
          <dd class="text-gray-900"><%= (@issuance.course.workload_hours || @issuance.certificate.total_hours).to_i %> horas</dd>
        </div>
        <div>
          <dt class="font-medium text-gray-500">Concluído em</dt>
          <dd class="text-gray-900"><%= l(@issuance.completed_at.to_date, format: :default) %></dd>
        </div>
      </dl>
      <%= link_to "Abrir certificado", @certificate_url, target: "_blank", rel: "noopener", class: "mt-6 inline-flex rounded-lg bg-green-700 px-4 py-2.5 text-sm font-medium text-white hover:bg-green-800" %>
    </section>

    <iframe src="<%= @certificate_url %>" title="Certificado" class="h-[42rem] w-full rounded-lg border border-gray-200 bg-gray-100"></iframe>
  </div>
</main>
