<% if Current.company&.logo&.attached? %>
  <%= image_tag Current.company.logo,
                alt: Current.company.fantasy_name,
                class: local_assigns.fetch(:class_name, "h-16 max-w-56 object-contain") %>
<% else %>
  <span class="text-2xl font-semibold whitespace-nowrap dark:text-white">
    <%= Current.company&.fantasy_name.presence || "Aprenda" %>
  </span>
<% end %>
