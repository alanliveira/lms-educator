<!DOCTYPE html>
<html>
  <head>
    <title>Portal Educacional - <%= " - #{Current.user.company.identifier}" if Current&.user&.company&.identifier %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <link href="//vjs.zencdn.net/8.3.0/video-js.min.css" rel="stylesheet" data-turbo-track="reload">
    <script src="//vjs.zencdn.net/8.3.0/video.min.js" data-turbo-track="reload"></script>
  </head>
  <body class="bg-gray-50 dark:bg-gray-900" data-controller="ui-dark-mode ui-traked-user">
    <%= render 'layouts/navbar' if Current.user.present? %>
    <main class="px-4 2xl:px-0 pt-16 grid grid-cols-1 bg-gray-50 dark:bg-gray-900">
      <%# render 'layouts/sidebar' %>
      <%= yield %>
    </main>
    <footer>
      <div class="text-center text-gray-500 text-sm py-4">
        &copy; <%= Time.current.year %> Seetech&reg;. Todos os direitos reservados.
      </div>
    </footer>
  </body>
</html>
