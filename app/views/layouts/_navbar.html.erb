<header>
  <nav class="fixed z-30 w-full bg-white border-b border-gray-200 dark:bg-gray-800 dark:border-gray-700 py-3 px-4">
    <div class="flex justify-between items-center">
      <div class="flex justify-start items-center">
        <%= link_to root_path, class: "flex items-center mr-14", aria: { label: "Página inicial" } do %>
          <%= render "layouts/company_logo", company: navigation[:company], class_name: "h-8 max-w-36 object-contain" %>
        <% end %>
        <!-- Desktop menu -->
        <div class="hidden justify-between items-center w-full lg:flex lg:w-auto lg:order-1">
          <ul class="flex flex-col mt-4 space-x-6 text-sm font-medium lg:flex-row xl:space-x-8 lg:mt-0">
            <li>
              <%= link_to 'Cursos',
                          courses_path,
                          class: 'block text-gray-700 hover:text-primary-700 dark:text-gray-400 dark:hover:text-white',
                          aria: { current: 'page' } %>
            </li>
            <li>
              <%= link_to 'Sessões',
                          sessions_path,
                          class: 'block text-gray-700 hover:text-primary-700 dark:text-gray-400 dark:hover:text-white' %>
            </li>
            <% if navigation[:show_users] %>
              <li>
                <%= link_to 'Usuários',
                          users_path,
                          class: 'block text-gray-700 hover:text-primary-700 dark:text-gray-400 dark:hover:text-white',
                          aria: { current: 'page' } %>
              </li>
            <% end %>
            <% if navigation[:show_companies] %>
              <li>
                <%= link_to 'Empresas',
                          companies_path,
                          class: 'block text-gray-700 hover:text-primary-700 dark:text-gray-400 dark:hover:text-white',
                          aria: { current: 'page' } %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <div class="flex justify-between items-center lg:order-2">
        <!-- Toggle dark mode -->
        <button id="theme-toggle" data-tooltip-target="tooltip-toggle" type="button" class="text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5">
          <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
          <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
        </button>
        <div id="tooltip-toggle" role="tooltip" class="inline-block absolute invisible z-10 py-2 px-3 text-sm font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 transition-opacity duration-300 tooltip">
          Alterar modo escuro
          <div class="tooltip-arrow" data-popper-arrow></div>
        </div>
        <%# User profile %>
        <%= button_to "Sair",
                      navigation[:session],
                      method: :delete,
                      class: 'hidden lg:block text-gray-500 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5' %>
        <button type="button" id="toggleMobileMenuButton" data-collapse-toggle="toggleMobileMenu" class="items-center p-2 text-gray-500 rounded-lg md:ml-2 lg:hidden hover:text-gray-900 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-white dark:hover:bg-gray-700 focus:ring-4 focus:ring-gray-300 dark:focus:ring-gray-600">
          <span class="sr-only">Open menu</span>
          <svg class="w-6 h-6" aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"></path></svg>
        </button>
      </div>
    </div>
  </nav>
  <nav class="bg-white dark:bg-gray-900">
    <!-- Mobile menu -->
    <ul id="toggleMobileMenu" class="hidden flex-col mt-0 pt-16 w-full text-sm font-medium lg:hidden">
      <li class="block border-b dark:border-gray-700">
        <%= link_to 'Cursos',
                    courses_path,
                    class: 'block py-3 px-4 text-gray-900 lg:py-0 dark:text-white lg:hover:underline lg:px-0',
                    data: { turbo: false },
                    aria: { current: 'page' } %>
      </li>
      <li class="block border-b dark:border-gray-700">
        <%= link_to 'Sessões',
                    sessions_path,
                    class: 'block py-3 px-4 text-gray-900 lg:py-0 dark:text-white lg:hover:underline lg:px-0',
                    data: { turbo: false } %>
      </li>
      <% if navigation[:show_users] %>
        <li class="block border-b dark:border-gray-700">
          <%= link_to 'Usuários',
                      users_path,
                      class: 'block py-3 px-4 text-gray-900 lg:py-0 dark:text-white lg:hover:underline lg:px-0',
                      data: { turbo: false },
                      aria: { current: 'page' } %>
        </li>
      <% end %>
      <% if navigation[:show_companies] %>
        <li class="block border-b dark:border-gray-700">
          <%= link_to 'Empresas',
                      companies_path,
                      class: 'block py-3 px-4 text-gray-900 lg:py-0 dark:text-white lg:hover:underline lg:px-0',
                      data: { turbo: false },
                      aria: { current: 'page' } %>
        </li>
      <% end %>
      <li class="block border-b dark:border-gray-700">
        <%= link_to 'Sair',
                    session_path(navigation[:session]),
                    class: 'block py-3 px-4 text-gray-900 lg:py-0 dark:text-white lg:hover:underline lg:px-0',
                    data: { turbo_method: :delete },
                    aria: { current: 'page' } %>
      </li>
    </ul>
  </nav>
</header>
