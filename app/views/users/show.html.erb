<div class="grid w-full grid-cols-1 pt-6 2xl:px-4 xl:grid-cols-3 xl:gap-4 dark:bg-gray-900">
  <div class="mb-4 col-span-full xl:mb-2">
    <%= render 'shared/notification' %>
    <div class="flex items-center mb-4 sm:mb-0">
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
        <div class="flex">
          <%= link_to users_path(@course),
                    class: 'font-medium rounded-lg text-sm px-0 pt-1.5' do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
            </svg>
          <% end %>
          <div class="flex flex-col">
            <%= tag.span @user.full_name %>
            <span class="font-normal text-sm text-gray-300">
              <%= 'Administrador' if @user.has_role?(:admin) %>
              <%= 'Empresa' if @user.has_role?(:company) %>
              <%= 'Colaborador' if @user.has_role?(:student) %>
            </span>
          </div>
        </div>
      </h1>
    </div>
  </div>
  <%# Informações do usuario %>
  <div class="col-span-full xl:col-auto">
    <div class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-gray-800">
      <div class="items-center sm:flex xl:block 2xl:flex sm:space-x-4 xl:space-x-0 2xl:space-x-4">
        <%#= image_tag @course.thumbnail, class: 'mb-4 rounded-lg w-28 h-28 sm:mb-0 xl:mb-4 2xl:mb-0' %>
        <div>
          <h3 class="mb-1 text-xl font-bold text-gray-900 dark:text-white">
            <%= @user.full_name %>
          </h3>
          <hr class="my-2">
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <span class="font-semibold"><%= User.human_attribute_name(:email) %>: </span>  <%= @user.email %>
          </div>
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <span class="font-semibold"><%= User.human_attribute_name(:department) %>: </span>  <%= @user.department %>
          </div>
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <span class="font-semibold"><%= User.human_attribute_name(:active) %>: </span>  <%= @user.active? ? 'Sim' : 'Não' %>
          </div>
          <div class="text-sm text-gray-500 dark:text-gray-400">
            <span class="font-semibold"><%= User.human_attribute_name(:verified) %>: </span>  <%= @user.verified? ? 'Sim' : 'Não' %>
          </div>
          <div class="mt-6 flex items-center space-x-4">
            <%# Ação principal %>
            <% if Current.user.has_role?(:admin) %>
              <div class="flex gap-2">
                <%= link_to "Editar",
                            edit_user_path(@user),
                            class: 'inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-primary-700 hover:bg-primary-800 focus:ring-4 focus:ring-primary-300 dark:bg-primary-600 dark:hover:bg-primary-700 dark:focus:ring-primary-800' %>
                <% if @user.active? %>
                  <%= link_to "Desaprovar",
                              status_user_path(@user),
                              data: { turbo_prepend: false, turbo_method: :get, turbo_confirm: "Deseja realmente aprovar o usuário?" },
                              class: 'inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-red-700 hover:bg-red-800 focus:ring-4 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-800' %>
                <% else %>
                  <%= link_to "Aprovar",
                              status_user_path(@user),
                              data: { turbo_prepend: false, turbo_method: :get, turbo_confirm: "Deseja realmente desaprovar o usuário?" },
                              class: 'inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white rounded-lg bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-green-300 dark:bg-green-600 dark:hover:bg-green-700 dark:focus:ring-green-800' %>
                <% end %>
                <%= button_to "Excluir",
                              @user,
                              method: :delete,
                              class: 'py-2 px-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700' %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <%# Acesso dos dispostivos %>
    <div class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-gray-800">
      <div class="flex items-center justify-between mb-4">
        <h5 class="text-xl font-bold leading-none text-gray-900 dark:text-white">
          Acessos
        </h5>
      </div>
      <div class="flow-root">
        <% if @user.sessions.present? %>
          <ul role="list" class="divide-y divide-gray-200 dark:divide-gray-700">
            <% @user.sessions.each do |session| %>
              <li class="py-3 sm:py-4">
                <div class="">
                  <div class="">
                    <p class="text-sm font-medium text-gray-900 truncate dark:text-white">
                      <%= session.user_agent %>
                    </p>
                    <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                      <span class="font-bold"><%= Session.human_attribute_name(:created_at) %>:</span>
                      <%= l session.created_at %>
                    </p>
                    <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                      <span class="font-bold"><%= Session.human_attribute_name(:updated_at) %>:</span>
                      <%= l session.updated_at %>
                    </p>
                    <p class="text-sm text-gray-500 truncate dark:text-gray-400">
                      <span class="font-bold"><%= Session.human_attribute_name(:ip_address) %>:</span>
                      <%= session.ip_address %>
                    </p>
                  </div>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <div class="p-4 mb-4 text-sm text-blue-800 rounded-lg bg-blue-50 dark:bg-blue-800 dark:text-blue-400" role="alert">
            <span class="font-medium">Usuário não se logou no sistema</span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <%# Listagem dos tópicos dos cursos %>
  <div class="col-span-2">
    <div class="p-4 mb-4 bg-white border border-gray-200 rounded-lg shadow-sm 2xl:col-span-2 dark:border-gray-700 sm:p-6 dark:bg-gray-800">
      <div class="flex justify-between mb-4">
        <h3 class="mb-4 text-xl font-semibold dark:text-white">
          Histórico do sistema
        </h3>
        <%#= link_to 'Adicionar aula',
                  new_course_course_class_path(@course),
                  class: 'text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800' %>
      </div>
      <%# Adicionar logs e outras informações %>
      <% if @user.histories.present? %>
        <div class="relative overflow-x-auto shadow-md sm:rounded-lg">
          <table class="w-full text-sm text-left rtl:text-right text-gray-500 dark:text-gray-400">
            <thead class="text-xs text-gray-700 uppercase bg-gray-50 dark:bg-gray-700 dark:text-gray-400">
              <tr>
                <th scope="col" class="px-6 py-3">
                  <%= History.human_attribute_name(:action) %>
                </th>
                <th scope="col" class="px-6 py-3">
                  <%= History.human_attribute_name(:created_at) %>
                </th>
              </tr>
            </thead>
            <tbody>
              <% @user.histories.each do |history| %>
                <tr class="bg-white border-b dark:bg-gray-800 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-600">
                  <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">
                    <%= history.action %>
                  </th>
                  <td class="px-6 py-4">
                    <%= l history.created_at %>
                  </td>
                <% end %>
              </tr>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-4 mb-4 text-sm text-blue-800 rounded-lg bg-blue-50 dark:bg-blue-800 dark:text-blue-400" role="alert">
          <span class="font-medium">Nenhum histórico registrado no sistema</span>
        </div>
      <% end %>
    </div>
  </div>
</div>