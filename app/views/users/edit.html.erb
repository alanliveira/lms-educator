<div class="pt-6">
  <div class="grid gap-4 grid-cols-1">
    <%# CAbeçalho %>
    <div class="col-span-1 flex items-center justify-between md:divide-x md:divide-gray-100 dark:divide-gray-700">
      <%# Título da página %>
      <h1 class="text-xl font-semibold text-gray-900 sm:text-2xl dark:text-white">
        <div class="flex">
          <%= link_to user_path(@user),
                    class: 'font-medium rounded-lg text-sm px-0 pt-1.5' do %>
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path fill-rule="evenodd" d="M7.72 12.53a.75.75 0 0 1 0-1.06l7.5-7.5a.75.75 0 1 1 1.06 1.06L9.31 12l6.97 6.97a.75.75 0 1 1-1.06 1.06l-7.5-7.5Z" clip-rule="evenodd" />
            </svg>
          <% end %>
          <div class="flex flex-col">
            Editar <%= User.model_name.human.singularize %>
          </div>
        </h1>
        <%# Ações %>
        <div>
          <%= link_to 'voltar',
                    user_path(@user),
                    class: 'text-white bg-green-700 hover:bg-green-800 focus:ring-4 focus:ring-primary-300 font-medium rounded-lg text-sm px-5 py-2.5 dark:bg-primary-600 dark:hover:bg-primary-700 focus:outline-none dark:focus:ring-primary-800' %>
        </div>
      </div>
      <%# Corpo %>
      <div class="col-span-1">
        <%# Corpo %>
        <%= render 'form', user: @user %>
      </div>
    </div>
  </div>
