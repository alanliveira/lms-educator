# ==============================================================================
# Educator LMS — modelo de variáveis de ambiente
# Copie para .env e preencha:  cp .env.sample .env
# O arquivo .env é ignorado pelo Git e NUNCA deve ser commitado.
# ==============================================================================

# --- Database ----------------------------------------------------------------
# Local (docker-compose já sobe o Postgres em localhost:5432):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/educator_lms_development
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/educator_lms_test

# --- Rails -------------------------------------------------------------------
# development | test | production
RAILS_ENV=development
# Descriptografa config/credentials.yml.enc (ver README: "Como obter")
RAILS_MASTER_KEY=change-me
# Opcional (padrão: info)
RAILS_LOG_LEVEL=info
# Opcional (padrão: 5)
RAILS_MAX_THREADS=5
# Opcional (padrão: igual a RAILS_MAX_THREADS)
RAILS_MIN_THREADS=5
# Host permitido em development (padrão: localhost:3000)
RAILS_DEVELOPMENT_HOST=localhost:3000
# Workers do Puma em produção (padrão: nº de CPUs)
WEB_CONCURRENCY=2
# Porta do servidor (padrão: 3000)
PORT=3000

# --- Redis (Action Cable / cable.yml) ----------------------------------------
# Local: redis://localhost:6379/1 — Produção: URL do serviço Redis/Upstash
REDIS_URL=redis://localhost:6379/1

# --- E-mail (Resend) ---------------------------------------------------------
# Chave de API do Resend (ver README: "Como obter")
RESEND_API_KEY=re_xxxxxxxxxxxx
# Remetente padrão; o domínio precisa estar verificado no Resend
EMAIL_ADMINISTRATION_SYSTEM=seu-email@seudominio.com
# Host usado nos links dos e-mails (ex.: educator.app.br ou localhost:3000)
EMAIL_HOST=localhost:3000

# --- Storage Supabase S3 (usado em produção: config/storage.yml) -------------
# Dashboard Supabase → Project Settings → Storage → S3 API
SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_KEY=<access-key-id>
SUPABASE_KEY_SECRET=<secret-access-key>

# --- Dados da aplicação ------------------------------------------------------
# id da Company padrão usada nos e-mails (ex.: Company.first.id)
COMPANY_DEFAULT_ID=1

# --- Opcional: Azure Storage (serviço :microsoft, não é o default) -----------
# Azure Portal → Storage account → Access keys
AZURE_ACTIVE_STORAGE=
