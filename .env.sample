# ==============================================================================
# Educator LMS — modelo de variáveis de ambiente
# ==============================================================================
#
# COMO USAR:
#   1. Crie uma cópia deste arquivo:  cp .env.sample .env
#   2. Preencha os valores de cada variável conforme os comentários acima
#      de cada chave (formato, onde obter, etc.).
#   3. O arquivo .env é ignorado pelo Git e NUNCA deve ser commitado.
#
# IMPORTANTE: este modelo não contém valores — apenas as chaves vazias.
# Exceção: as chaves lidas pelo docker-compose.yml já vêm com default, para que
# `cp .env.sample .env` + `docker compose config` funcionem sem nenhum ajuste.
# ==============================================================================

# --- Database ----------------------------------------------------------------
# Local (docker-compose já sobe o Postgres em localhost:5432):
# Formato: postgres://USER:PASSWORD@HOST:PORT — SEM o nome do database, ele
# vem do config/database.yml (educator_lms_development/_test/_production)
DATABASE_URL=
# Credenciais do serviço `db` do docker-compose.yml (use os mesmos valores de
# DATABASE_URL). O compose lê aqui por interpolação — nada é digitado no compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=educator_lms_development
# Porta publicada do Postgres no host
POSTGRES_PORT=5432

# --- Rails -------------------------------------------------------------------
# development | test | production
RAILS_ENV=
# Descriptografa config/credentials.yml.enc (ver docs/environment.md)
RAILS_MASTER_KEY=
# Opcional (padrão: info) — development | debug | info | warn | error | fatal
RAILS_LOG_LEVEL=
# Opcional (padrão: 5)
RAILS_MAX_THREADS=
# Opcional (padrão: igual a RAILS_MAX_THREADS)
RAILS_MIN_THREADS=
# Host permitido em development (ex.: localhost:3000)
RAILS_DEVELOPMENT_HOST=
# Workers do Puma em produção (ex.: 2)
WEB_CONCURRENCY=
# Porta do servidor (ex.: 3000)
PORT=

# --- Redis (Action Cable / cable.yml) ----------------------------------------
# Local: redis://localhost:6379/1 — Produção: URL do serviço Redis/Upstash
REDIS_URL=

# --- E-mail (Resend) ---------------------------------------------------------
# Chave de API do Resend (ver docs/environment.md) — ex.: re_xxxxxxxxxxxx
RESEND_API_KEY=
# Remetente padrão; o domínio precisa estar verificado no Resend
# (também é um ARG do `docker compose build`)
EMAIL_ADMINISTRATION_SYSTEM=admin@example.test
# Host usado nos links dos e-mails (ex.: educator.app.br ou localhost:3000)
EMAIL_HOST=

# --- Storage Supabase S3 (config/storage.yml) ---------------------------------
# Também são ARGs do `docker compose build` (o `assets:precompile` sobe a app e
# resolve o serviço S3). Localmente apontam para o Supabase local.
# Em development: `supabase start` e pegue os valores com
#   supabase status -o env | grep -E "STORAGE_S3_URL|S3_PROTOCOL"
# Em produção: Dashboard Supabase → Project Settings → Storage → S3 API
#   Endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3
# Buckets: o bucket `contents-class` (privado) é criado pelo `supabase start`
# (supabase/config.toml) ou manualmente: POST /storage/v1/bucket
SUPABASE_STORAGE_ENDPOINT=http://127.0.0.1:54421/storage/v1/s3
SUPABASE_KEY=placeholder
SUPABASE_KEY_SECRET=placeholder
# Região do SigV4: "local" no Supabase local, "sa-east-1" em produção
SUPABASE_STORAGE_REGION=local

# --- Dados da aplicação ------------------------------------------------------
# --- Opcional: Azure Storage (serviço :microsoft, não é o default) -----------
# Azure Portal → Storage account → Access keys
AZURE_ACTIVE_STORAGE=
